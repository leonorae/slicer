{
  "_comment": "Notebook consolidated config — GPT-2, all Exp 1+3 probes, alpha=1 and 1000, last layer only.",
  "_covers": ["Exp 1 (alpha compression visibility)", "Exp 3 (alpha sensitivity as novelty detector)"],

  "models": {
    "llm": "gpt2",
    "sd": "sd-legacy/stable-diffusion-v1-5",
    "clip_model": "ViT-L-14",
    "clip_pretrained": "openai"
  },

  "projections": {
    "types": ["per_layer"],
    "alpha_values": [1, 1000, 10000],
    "training_data_size": 5000
  },

  "probe_texts": {
    "concrete":        ["a cat", "a dog", "a house", "a tree"],
    "abstract":        ["democracy", "justice", "entropy", "grief"],
    "common_concrete": ["a cat", "a dog", "a house"],
    "common_abstract": ["democracy", "justice", "beauty"],
    "unusual":         [
      "the feeling of almost remembering",
      "the color of Tuesday",
      "entropy at midnight"
    ]
  },

  "layers": [11],

  "cfg_values": [7.5],
  "seeds": [42, 123, 777, 456, 789, 101, 234, 567, 890, 111, 222, 333, 444, 555, 666, 999],

  "output": {
    "base_dir": "./experiment_results_nb_gpt2",
    "image_format": "png"
  },

  "use_auto_corpus": true
}
