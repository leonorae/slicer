{
  "_comment": "Diffusion Microscope experiment config. Copy and edit this file.",

  "models": {
    "llm": "gpt2",
    "sd": "sd-legacy/stable-diffusion-v1-5",
    "clip_model": "ViT-L-14",
    "clip_pretrained": "openai"
  },

  "projections": {
    "types": ["single_final_layer", "mixed_layer"],
    "alpha_values": [1, 10, 100, 1000, 10000],
    "training_data_size": 5000
  },

  "probe_texts": {
    "concrete":  ["a cat on a roof", "a dog", "a house", "a tree", "a car"],
    "abstract":  ["therefore", "irony", "democracy", "causality", "beauty"],
    "function":  ["the", "and", "but", "however", "because"],
    "novel":     ["purple elephant", "singing skyscraper", "quantum turtle",
                  "liquid glass", "frozen lightning"],
    "interpolations": [
      {"from": "cat", "to": "dog",   "steps": 5},
      {"from": "king", "to": "queen", "steps": 5}
    ]
  },

  "layers": null,

  "cfg_values": [1.5, 3.0, 5.0, 7.0, 9.0, 12.0, 15.0],
  "seeds": [42, 43, 44],

  "output": {
    "base_dir": "./experiment_results",
    "image_format": "png"
  },

  "use_auto_corpus": true
}
